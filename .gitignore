# --- exploration lab runtime ---
# Persistent browser profiles carry live auth — never commit.
sessions/*/state/
# Raw per-run captures are large and not meant to be shared.
sessions/*/*/
# `latest` symlink at sessions/<slug>/latest points into the excluded
# capture dir — useless without its target, so drop it too.
sessions/*/latest

