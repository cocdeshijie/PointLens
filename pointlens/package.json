{
  "name": "point-lens",
  "displayName": "Point Lens",
  "version": "1.0.5",
  "description": "See hotel award point value (cents per point) at a glance on Hilton, IHG, Marriott, and Hyatt search results.",
  "author": "cocdeshijie",
  "scripts": {
    "dev": "plasmo dev",
    "build": "plasmo build",
    "package": "plasmo package",
    "typecheck": "tsc --noEmit",
    "test:unit": "node --test tests/*.test.mjs",
    "test:browser": "playwright test",
    "test": "npm run test:unit && npm run test:browser"
  },
  "dependencies": {
    "jotai": "^2.20.1",
    "plasmo": "0.90.5",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "react-icons": "^5.5.0"
  },
  "devDependencies": {
    "@ianvs/prettier-plugin-sort-imports": "4.1.1",
    "@playwright/test": "^1.63.0",
    "@types/chrome": "0.0.258",
    "@types/node": "20.11.5",
    "@types/react": "18.2.48",
    "@types/react-dom": "18.2.18",
    "javascript-obfuscator": "^5.4.3",
    "jsdom": "^30.0.1",
    "prettier": "3.2.4",
    "typescript": "5.3.3"
  },
  "manifest": {
    "permissions": [
      "storage",
      "webRequest",
      "tabs"
    ],
    "host_permissions": [
      "https://*/*"
    ],
    "web_accessible_resources": [
      {
        "resources": [
          "hotels/hilton/injected/hilton-fetch-hook.js",
          "hotels/hilton/injected/hilton-map-overlay.js",
          "hotels/marriott/injected/marriott-fetch-hook.js"
        ],
        "matches": [
          "https://www.hilton.com/*",
          "https://www.marriott.com/*"
        ]
      }
    ]
  }
}
